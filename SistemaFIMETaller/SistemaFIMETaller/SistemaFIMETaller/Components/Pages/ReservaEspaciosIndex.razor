@page "/reserva"
@attribute [Authorize]
@using SistemaFIMETaller.Services.EspaciosServices
@rendermode InteractiveServer
@inject NavigationManager _navigator
@inject IReservaEspacioService _reservaService
@inject ExcelService ExcelService
@inject IJSRuntime JS


<h3>Reserva de espacios</h3>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Buscar por alumno, profesor o espacio"
                   @bind="_filtro" @bind:event="oninput" />
            <button class="btn btn-outline-secondary" type="button" @onclick="AplicarFiltro">
                <i class="bi bi-search"></i> Buscar
            </button>

            <AuthorizeView Roles="Admin">
                <button class="btn btn-success ms-2" @onclick="ExportarExcel">
                    Exportar Excel
                </button>
            </AuthorizeView>
        </div>
    </div>

    <div class="col-md-6 text-end">
        <a class="btn btn-primary" href="/reserva/nuevo">Nueva reserva</a>
    </div>
</div>

@if (_reservas == null)
{
    <div class="spinner-border"></div>
}
else if (_reservasFiltradas.Count == 0)
{
    <div class="alert alert-warning">No se encontraron reservas</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Espacio</th>
                <th>Alumno</th>
                <th>Profesor</th>
                <th>Fecha</th>
                <th>Hora Inicio</th>
                <th>Hora Fin</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in _reservasFiltradas)
            {
                <tr>
                    <td>@r.ReservaId</td>
                    <td>@r.Espacio?.NombreEspacio</td>
                    <td>@r.Alumno?.Nombre</td>
                    <td>@r.Profesor?.NombreProfesor</td>
                    <td>@r.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>@r.HoraInicio</td>
                    <td>@r.HoraFin</td>
                    
                    <AuthorizeView Roles="Admin, Avanzado">
                    <td>
                        <button class="btn btn-outline-secondary btn-sm me-1" @onclick="() => Editar(r.ReservaId)">
                            Editar
                        </button>

                        <button class="btn btn-outline-danger btn-sm" @onclick="() => Eliminar(r)">
                            Eliminar
                        </button>
                    </td>

                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}



@code {
    private List<ReservaEspacio>? _reservas = new();
    private List<ReservaEspacio> _reservasFiltradas = new();

    private string _filtro = "";

    protected override async Task OnInitializedAsync()
    {
        _reservas = await _reservaService.ObtenerReservas();
        _reservasFiltradas = _reservas!.ToList();
    }

    private void Editar(int id)
    {
        _navigator.NavigateTo($"/reserva/editar/{id}");
    }

    private async Task Eliminar(ReservaEspacio re)
    {
        await _reservaService.Eliminar(re.ReservaId);
        _reservas!.Remove(re);
        AplicarFiltro();
        StateHasChanged();
       
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(_filtro))
        {
            _reservasFiltradas = _reservas!.ToList();
            return;
        }

        var termino = _filtro.Trim().ToLower();

        _reservasFiltradas = _reservas!
        .Where(r =>
            (r.Profesor?.NombreProfesor?.ToLower().Contains(termino) ?? false) ||
            (r.Alumno?.Nombre?.ToLower().Contains(termino) ?? false) ||
            (r.Espacio?.NombreEspacio?.ToLower().Contains(termino) ?? false) ||
            r.Fecha.ToString("dd/MM/yyyy").Contains(termino))
        .ToList();
    }


    private async Task ExportarExcel()
    {
        var bytes = ExcelService.GenerarExcelReservaEspacios(_reservasFiltradas);

        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync(
            "downloadFile",
            $"reserva_espacios_{DateTime.Now:yyyyMMdd}.xlsx",
            base64
        );
    }

}


