@page "/prestamos"
@attribute [Authorize]
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject IPrestamoService _prestamoService
@inject IJSRuntime JS

<h3>Préstamos</h3>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Buscar por nombre, apellido, matrícula o grupo"
                   @bind="_filtro" @bind:event="oninput" />
            <button class="btn btn-outline-secondary" type="button" @onclick="AplicarFiltro">
                <i class="bi bi-search"></i> Buscar
            </button>
            <AuthorizeView Roles="Admin">
            <button class="btn btn-success ms-2" @onclick="ExportarExcel">
                Exportar Excel
            </button>
            </AuthorizeView>

        </div>
    </div>
    <div class="col-md-6 text-end">
        <a class="btn btn-primary" href="/prestamos/nuevo">Nuevo préstamo</a>
        
    </div>
</div>

@if (_prestamos == null)
{
    <div class="spinner-border"></div>
}
else if (_prestamosFiltrados.Count == 0)
{
    <div class="alert alert-warning">No se encontraron préstamos</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Alumno</th>
                <th>Fecha</th>
                <th>Materiales</th>
                <th>Estado</th>
                <th>Observaciones</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in _prestamosFiltrados)
            {
                <tr class="@GetClaseEstado(p)">
                    <td>@p.Id</td>
                    <td>@p.Alumno?.Nombre</td>
                    <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                    <td>
                        @(p.PrestamoMateriales != null && p.PrestamoMateriales.Any()
                                        ? string.Join(", ", p.PrestamoMateriales.Select(pm => pm.Material?.Nombre))
                                        : "(sin materiales)")
            </td>

                    <td>
                @if (p.Estado)
                        {
                            <span class="badge bg-primary">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Entregado</span>
                        }
                    </td>

                    <td>@(string.IsNullOrWhiteSpace(p.Observaciones) ? "-" : p.Observaciones)</td>

                    <td>
                        <AuthorizeView Roles="Admin, Avanzado">
                        <button class="btn btn-outline-secondary btn-sm me-1" @onclick="() => Editar(p.Id)">Editar</button>
                        </AuthorizeView>
                        @if (p.Estado)
                        {
                            <button class="btn btn-success btn-sm me-1" @onclick="() => MarcarEntregado(p)">
                                Entregado
                            </button>
                        }
                        
                        <AuthorizeView Roles="Admin, Avanzado">
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarAsync(p)">
                            Eliminar
                        </button>
                        </AuthorizeView>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<SistemaFIMETaller.Models.Prestamo>? _prestamos;
    private List<SistemaFIMETaller.Models.Prestamo> _prestamosFiltrados = new();
    private string _filtro = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _prestamos = await _prestamoService.ObtenerTodos();
        _prestamosFiltrados = _prestamos!.ToList();
    }

    private string GetClaseEstado(SistemaFIMETaller.Models.Prestamo p)
    {
        return p.Estado ? "table-info" : "table-danger";
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(_filtro))
        {
            _prestamosFiltrados = _prestamos!.ToList();
            return;
        }

        var termino = _filtro.Trim().ToLower();

        _prestamosFiltrados = _prestamos!
            .Where(p =>
                p.Alumno!.Nombre.ToLower().Contains(termino) ||
                p.Fecha.ToString("dd/MM/yyyy").Contains(termino))
            .ToList();
    }

    private void Editar(int id)
    {
        Nav.NavigateTo($"/prestamos/editar/{id}");
    }

    private async Task MarcarEntregado(SistemaFIMETaller.Models.Prestamo p)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Marcar como entregado?")) return;

        p.Estado = false;
        await _prestamoService.Actualizar(p);

        AplicarFiltro();
        StateHasChanged();
    }

    private async Task EliminarAsync(SistemaFIMETaller.Models.Prestamo p)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "¿Eliminar préstamo?")) return;

        await _prestamoService.Eliminar(p.Id);
        _prestamos!.Remove(p);
        AplicarFiltro();
        StateHasChanged();
    }

    @inject ExcelService ExcelService

    private async Task ExportarExcel()
    {
        var bytes = ExcelService.GenerarExcelPrestamos(_prestamosFiltrados);

        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync("downloadFile", $"prestamos_{DateTime.Now:yyyyMMdd}.xlsx", base64);
    }

}
