@page "/alumnos"
@rendermode InteractiveServer
@attribute [Authorize]
@inject NavigationManager _navigator
@inject IAlumnoService _alumnoService
@inject ExcelService ExcelService
@inject IJSRuntime JS

<h3>Alumnos</h3>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Buscar por nombre, apellido, matrícula o grupo"
                   @bind="_filtroBusqueda" @bind:event="oninput" />
            <button class="btn btn-outline-secondary" type="button" @onclick="AplicarFiltro">
                <i class="bi bi-search"></i> Buscar
            </button>

            

            <AuthorizeView Roles="Admin">
            <button class="btn btn-success ms-2" @onclick="ExportarExcel">
                Exportar Excel
            </button>
            </AuthorizeView>
        </div>
    </div>
    <div class="col-md-6 text-end">
        <a class="btn btn-primary" href="alumnos/nuevo">Agregar alumno</a>
    </div>
</div>

@if (_alumnos == null)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
}
else if (_alumnosFiltrados.Count == 0)
{
    <div class="alert alert-warning">
        @if (string.IsNullOrEmpty(_filtroBusqueda))
        {
            <span>No hay alumnos registrados</span>
        }
        else
        {
            <span>No se encontraron alumnos con ese criterio</span>
        }
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Matrícula</th>
                <th>Grupo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in _alumnosFiltrados)
            {
                <tr>
                    <td>@a.Nombre</td>
                    <td>@a.Apellido</td>
                    <td>@a.NumeroCuenta</td>
                    <td>@a.Grupo</td>
                    <AuthorizeView Roles="Admin, Avanzado">
                    <td>
                        <button class="btn btn-outline-secondary me-1" @onclick="@(() => Modificar(a.AlumnoId))">Editar</button>
                        <button class="btn btn-outline-danger" @onclick="@(() => EliminarAsync(a))">Eliminar</button>
                    </td>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Alumno>? _alumnos;
    private List<Alumno> _alumnosFiltrados = new();
    private string _filtroBusqueda = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _alumnos = await _alumnoService.ObtenerTodos();
        _alumnosFiltrados = _alumnos.ToList();
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(_filtroBusqueda))
        {
            _alumnosFiltrados = _alumnos!.ToList();
            return;
        }

        var t = _filtroBusqueda.ToLower().Trim();

        _alumnosFiltrados = _alumnos!
            .Where(a =>
                a.Nombre.ToLower().Contains(t) ||
                a.Apellido.ToLower().Contains(t) ||
                a.NumeroCuenta.ToLower().Contains(t) ||
                a.Grupo.ToLower().Contains(t)
            )
            .ToList();
    }

    private async Task EliminarAsync(Alumno alumno)
    {
        await _alumnoService.Eliminar(alumno.AlumnoId);
        _alumnos!.Remove(alumno);
        AplicarFiltro();
        StateHasChanged();
    }

    private void Modificar(int id)
    {
        _navigator.NavigateTo($"/alumnos/editar/{id}");
    }

    private async Task ExportarExcel()
    {
        var bytes = ExcelService.GenerarExcelAlumnos(_alumnosFiltrados);

        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync(
            "downloadFile",
            $"alumnos_{DateTime.Now:yyyyMMdd}.xlsx",
            base64
        );
    }

}
