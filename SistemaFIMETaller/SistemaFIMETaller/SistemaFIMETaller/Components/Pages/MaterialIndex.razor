@page "/materiales"
@rendermode InteractiveServer
@attribute [Authorize]
@inject NavigationManager _navigator
@inject IMaterialService _materialService
@inject ExcelService ExcelService
@inject IJSRuntime JS

<h3>Materiales</h3>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Buscar por número, nombre, marca o ubicación"
                   @bind="_filtroBusqueda" @bind:event="oninput" />
            <button class="btn btn-outline-secondary" type="button" @onclick="AplicarFiltro">
                <i class="bi bi-search"></i> Buscar
            </button>
            <AuthorizeView Roles="Admin">
            <button class="btn btn-success ms-2" @onclick="ExportarExcel">
                Exportar Excel
            </button>
            </AuthorizeView>
        </div>
    </div>
    <div class="col-md-6 text-end">
        <a class="btn btn-success" href="materiales/nuevo">Agregar nuevo material</a>
    </div>
</div>

@if (_materiales == null)
{
    <div class="spinner-border" role="status">
        <span class="visually-hidden">Cargando...</span>
    </div>
}
else if (_materialesFiltrados.Count == 0)
{
    <div class="alert alert-warning">
        @if (string.IsNullOrEmpty(_filtroBusqueda))
        {
            <span>No hay materiales registrados</span>
        }
        else
        {
            <span>No se encontraron materiales con el criterio de búsqueda</span>
        }
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Número</th>
                <th>Nombre</th>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Serie</th>
                <th>Ubicación</th>
                <th>Custodio</th>
                <th>Observaciones</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in _materialesFiltrados)
            {
                <tr>
                    <td>@m.Numero</td>
                    <td>@m.Nombre</td>
                    <td>@m.Marca</td>
                    <td>@m.Modelo</td>
                    <td>@m.Serie</td>
                    <td>@m.Ubicacion</td>
                    <td>@m.Custodio</td>
                    <td>@m.Observaciones</td>
                    <AuthorizeView Roles="Admin, Avanzado">
                    <td>
                        <button class="btn btn-outline-secondary me-1" @onclick="@(() => Modificar(m.Id))">Editar</button>
                        <button class="btn btn-outline-danger" @onclick="@(() => EliminarAsync(m))">Eliminar</button>
                    </td>
                    </AuthorizeView>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Material>? _materiales;
    private List<Material> _materialesFiltrados = new();
    private string _filtroBusqueda = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _materiales = await _materialService.ObtenerTodos();
        _materialesFiltrados = _materiales.ToList();
    }

    private void AplicarFiltro()
    {
        if (string.IsNullOrWhiteSpace(_filtroBusqueda))
        {
            _materialesFiltrados = _materiales!.ToList();
            return;
        }

        var termino = _filtroBusqueda.ToLower().Trim();
        _materialesFiltrados = _materiales!
            .Where(m =>
                (!string.IsNullOrEmpty(m.Numero) && m.Numero.ToLower().Contains(termino)) ||
                (!string.IsNullOrEmpty(m.Nombre) && m.Nombre.ToLower().Contains(termino)) ||
                (!string.IsNullOrEmpty(m.Marca) && m.Marca.ToLower().Contains(termino)) ||
                (!string.IsNullOrEmpty(m.Ubicacion) && m.Ubicacion.ToLower().Contains(termino))
            )
            .ToList();
    }

    private async Task EliminarAsync(Material material)
    {
        await _materialService.Eliminar(material.Id);
        _materiales!.Remove(material);
        AplicarFiltro();
        StateHasChanged();
    }

    private void Modificar(int id)
    {
        _navigator.NavigateTo($"/materiales/editar/{id}");
    }
    private async Task ExportarExcel()
    {
        var bytes = ExcelService.GenerarExcelMateriales(_materialesFiltrados);

        var base64 = Convert.ToBase64String(bytes);

        await JS.InvokeVoidAsync(
            "downloadFile",
            $"materiales_{DateTime.Now:yyyyMMdd}.xlsx",
            base64
        );
    }

}
